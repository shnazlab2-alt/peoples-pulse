 {
  "title": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WMQ • What Matters?</title>\n    <script src=\"https:/cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https:/cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\n    <style>\n        @import url('https:/fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600&display=swap');\n        \n        body { font-family: 'Inter', system_ui, sans-serif; }\n        .logo-font { font-family: 'Space Grotesk', system_ui, sans-serif; }\n        \n        .cosmic-bg {\n            background: radial-gradient(circle at center, #1a1a2e 0%, #0f0f1a 100%);\n        }\n        \n        .glass {\n            background: rgba(255,255,255,0.05);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(255,255,255,0.1);\n        }\n    </style>\n</head>\n<body class=\"bg- text-white cosmic-bg min-h-screen\">\n\n    <div class=\"max-w-2xl mx-auto p-4\">\n        <div class=\"flex justify-between items-center mb-6\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"w-11 h-11 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center\">\n                    <i class=\"fa-solid fa-question text-white text-3xl\"></i>\n                </div>\n                <div>\n                    <span class=\"logo-font text-3xl font-semibold\">WMQ</span>\n                    <span class=\"text-xs text-indigo-400 block -mt-1\">WHAT MATTERS?</span>\n                </div>\n            </div>\n            <div onclick=\"showQR()\" class=\"flex items-center gap-2 bg-white/10 px-4 py-2 rounded-3xl text-sm cursor-pointer\">\n                <i class=\"fa-solid fa-qrcode\"></i>\n                <span>Share Profile</span>\n            </div>\n        </div>\n\n        <div class=\"glass rounded-3xl p-8 text-center\">\n            <img id=\"profile-pic\" src=\"jeffrey-profile.jpg\" \n                 class=\"w-32 h-32 mx-auto rounded-2xl object-cover ring-4 ring-indigo-500 mb-6\" alt=\"Jeffrey Schnaus\">\n            \n            <h1 class=\"text-3xl font-semibold mb-1\">Jeffrey Schnaus</h1>\n            <p class=\"text-indigo-400\">@shnazart • Live Painter & WMQ Founder</p>\n\n            <div class=\"mt-8 flex justify-center gap-6\">\n                <div class=\"text-center\">\n                    <div class=\"text-4xl font-bold text-emerald-400\">94</div>\n                    <div class=\"text-xs text-white/60\">Credibility</div>\n                </div>\n                <div class=\"text-center\">\n                    <div class=\"text-4xl font-bold\">147</div>\n                    <div class=\"text-xs text-white/60\">Answers</div>\n                </div>\n            </div>\n\n            <button onclick=\"showQR()\" \n                    class=\"mt-10 w-full bg-gradient-to-r from-indigo-500 to-purple-600 py-4 rounded-2xl font-semibold flex items-center justify-center gap-3\">\n                <i class=\"fa-solid fa-qrcode\"></i>\n                Share My WMQ Profile\n            </button>\n        </div>\n    </div>\n\n    <script>\n        function showQR() {\n            const modal = document.createElement('div');\n            modal.className = 'fixed inset-0 bg-black/90 flex items-center justify-center z-50';\n            modal.innerHTML = `\n                <div class=\"bg-zinc-900 rounded-3xl p-8 max-w-xs w-full mx-4\">\n                    <div class=\"text-center\">\n                        <div class=\"text-lg font-semibold mb-4\">Share My WMQ Profile</div>\n                        <div class=\"bg-white p-4 rounded-2xl inline-block mb-6\">\n                            <img src=\"https:/api.qrserver.com/v1/create-qr-code/?size=220x220&data=https:/wmq.app/profile/shnazart\" \n                                 class=\"w-52 h-52\">\n                        </div>\n                        <div class=\"text-xs text-emerald-400 mb-1\">https:/wmq.app/profile/shnazart</div>\n                        <div class=\"text- text-white/50 mb-6\">Scan to connect with Jeffrey Schnaus on WMQ</div>\n                        \n                        <div class=\"flex gap-3\">\n                            <button onclick=\"copyLink()\" \n                                    class=\"flex-1 bg-white/10 hover:bg-white/20 py-3 rounded-2xl text-sm font-medium\">Copy Link</button>\n                            <button onclick=\"this.closest('.fixed').remove()\" \n                                    class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 py-3 rounded-2xl text-sm font-medium\">Close</button>\n                        </div>\n                    </div>\n                </div>\n            `;\n            document.body.appendChild(modal);\n        }\n\n        function copyLink() {\n            navigator.clipboard.writeText(\"https:/wmq.app/profile/shnazart\");\n            alert(\"Link copied! You can now share it.\");\n        }\n\n        / Tailwind script\n        function init() {\n            console.log('%c✅ WMQ Prototype Ready. Tap \"Share My WMQ Profile\" to test the QR code.', 'color:#6366f1; font-weight:bold');\n        }\n        window.onload = init;\n    </script>\n</body>\n</html>\n.txt",
